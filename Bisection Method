#include <iostream>
#include <cmath>
//intervals [a,b] that satisfy f(a).f(b)<0
double a;
double b;
//compute f(x)
double f(double x) {
	return x*x*exp(x) - 1;
}

int main() {
	std::cout << "Enter the value of a: ";
	std::cin >> a;
	std::cout << "Enter the value of b: ";
	std::cin >> b;
	if (f(a) * f(b) >= 0) {
		std::cout << "The function does not change sign in the interval [" << a << ", " << b << "]\n";
		return 1;
	}
	double m;
	for (int i = 1; i < 100; ++i) {
		m = (a + b) / 2;
		if (f(m) == 0.0) {
			break; // c is a root
		} else if (f(m) * f(a) < 0) {
			b = m; // root is in [a, m]
		} else {
			a = m; // root is in [m, b]
		}
		std::cout << "step " << i << " m = " << m<<"\n";
	}
	std::cout << "Root found: " << m << "\n";
	return 0;
}
